// The tankster-ai-review Worker. Deployed from main only: see README.md.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tankster-ai-review",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    // ai-review-ledger: daily neuron spend and reviewed commits.
    { "binding": "LEDGER", "id": "REPLACED_AT_DEPLOY" }
  ],
  // v2: one Durable Object per pull request (SQLite-backed, on Workers Free).
  // AppSecrets: the GitHub App's id, slug, key and webhook secret, stored by
  // the one-time manifest flow (GET /v1/setup/github-app). No person handles them.
  "durable_objects": {
    "bindings": [
      { "name": "PR_STATE", "class_name": "PrState" },
      { "name": "APP_SECRETS", "class_name": "AppSecrets" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrState", "AppSecrets"] }],
  "vars": {
    // Only the App's runner, on main, may claim jobs.
    "RUNNER_REFS": "TanksterAI/ai-review/.github/workflows/runner.yml@refs/heads/main",
    // TanksterAI's numeric organisation id: the OIDC token must carry it.
    "OWNER_ID": "259206056",
    "AUDIENCE": "tankster-ai-review",
    // Only this repository's reusable workflow, at v1 or main, may call.
    // Comma-separated; an entry ending in * is a prefix. Whoever can move v1
    // or push to main (write access to ai-review) is trusted: see README.md.
    "WORKFLOW_REFS": "TanksterAI/ai-review/.github/workflows/review.yml@refs/tags/v1,TanksterAI/ai-review/.github/workflows/review.yml@refs/heads/main",
    // Providers in order; an entry whose key is not set is skipped. See
    // README.md, "Model providers". Cheaper Workers AI models join the chain
    // with the finding verifier (TAN-299), not before.
    "DRAFT_CHAIN": "gemini:gemini-3.5-flash-lite,workers-ai:@cf/openai/gpt-oss-120b,anthropic:claude-haiku-5-5",
    // Dollars a day of the plan's Anthropic API credit (it stops at zero; never bills).
    "ANTHROPIC_DAILY_USD_CAP": "5",
    "MODEL": "@cf/openai/gpt-oss-120b",
    "REASONING_EFFORT": "medium",
    // Of the account's 10,000 free neurons a day; the rest stays for other Workers.
    "DAILY_NEURON_CAP": "6000",
    "MAX_DIFF_CHARS": "90000",
    // Reasoning counts as output: room for both, all reserved in the budget check.
    "MAX_OUTPUT_TOKENS": "12000"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
